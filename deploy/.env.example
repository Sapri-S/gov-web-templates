# Copy to deploy/.env and fill in. Never commit the real .env.

# Long random value, e.g. from: openssl rand -hex 32
DATABASE_PASSWORD=

# The staff identity provider's issuer URL (Login.gov, Entra ID, Okta, Keycloak...).
OIDC_ISSUER_URI=

# The public site address(es), comma-separated, e.g. https://services.example.gov
PORTAL_ALLOWED_ORIGINS=

# Client profile that loads apps/portal-api/src/main/resources/application-<client>.yml
SPRING_PROFILES_ACTIVE=default
