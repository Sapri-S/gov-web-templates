{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "40rem", "wideSize": "64rem" },
    "color": {
      "custom": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "primary", "name": "Primary (USWDS blue-60v)", "color": "#1a4480" },
        { "slug": "primary-dark", "name": "Primary dark (USWDS blue-80v)", "color": "#162e51" },
        { "slug": "accent", "name": "Accent (USWDS gold-30v)", "color": "#e5a000" },
        { "slug": "ink", "name": "Ink (USWDS gray-90)", "color": "#1b1b1b" },
        { "slug": "base-light", "name": "Base light (USWDS gray-5)", "color": "#f0f0f0" },
        { "slug": "white", "name": "White", "color": "#ffffff" },
        { "slug": "focus", "name": "Focus (USWDS blue-40v)", "color": "#2491ff" },
        { "slug": "emergency", "name": "Emergency (USWDS red-60v)", "color": "#b50909" },
        { "slug": "emergency-light", "name": "Emergency light (USWDS red-5)", "color": "#f9eeee" }
      ]
    },
    "typography": {
      "customFontSize": false,
      "fluid": false,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Public Sans",
          "fontFamily": "\"Public Sans\", \"Helvetica Neue\", Arial, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "medium", "name": "Body", "size": "1.0625rem" },
        { "slug": "large", "name": "Large", "size": "1.375rem" },
        { "slug": "x-large", "name": "Heading", "size": "2rem" },
        { "slug": "xx-large", "name": "Page title", "size": "2.5rem" }
      ]
    },
    "spacing": {
      "units": ["rem", "%"],
      "spacingSizes": [
        { "slug": "10", "name": "1 (0.5rem)", "size": "0.5rem" },
        { "slug": "20", "name": "2 (1rem)", "size": "1rem" },
        { "slug": "30", "name": "3 (1.5rem)", "size": "1.5rem" },
        { "slug": "40", "name": "4 (2rem)", "size": "2rem" },
        { "slug": "50", "name": "5 (3rem)", "size": "3rem" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--white)", "text": "var(--wp--preset--color--ink)" },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.6"
    },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--primary)" } },
      "heading": { "typography": { "fontWeight": "700", "lineHeight": "1.2" }, "color": { "text": "var(--wp--preset--color--ink)" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
      "button": {
        "color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--white)" },
        "border": { "radius": "0.25rem" },
        ":hover": { "color": { "background": "var(--wp--preset--color--primary-dark)" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
